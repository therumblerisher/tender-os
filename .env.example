# YTL ILMU API key (single key used for bge-m3 embeddings, bge-reranker, and ilmu-mini/v3.1 chat)
ILMU_API_KEY=

# PostgreSQL 16 + pgvector connection string
TENDER_OS_DATABASE_URL=postgresql://tenderos:tenderos@127.0.0.1:5439/tenderos
TENDER_OS_SNAPSHOT_PATH=data/tenders_public.jsonl
TENDER_OS_EMBEDDINGS_PATH=data/embeddings.f32

# YTL ILMU model routing (decided by PR0 bake-off)
TENDER_OS_ILMU_BASE_URL=https://api.ilmu.ai/v1
TENDER_OS_ILMU_EMBED_MODEL=bge-m3
TENDER_OS_ILMU_RERANK_MODEL=bge-reranker
TENDER_OS_ILMU_CHAT_PRIMARY_MODEL=ilmu-mini-v3.3
TENDER_OS_ILMU_CHAT_FALLBACK_MODEL=ilmu-v3.1
TENDER_OS_ILMU_TIMEOUT_SECONDS=15.0
TENDER_OS_ILMU_RERANK_TIMEOUT_SECONDS=5.0

# Guardrail floor calibrated on PR0 + dev-only probes
TENDER_OS_RERANK_FLOOR=0.04

# Daily MYT spending cap in MYR (atomic reserve-then-settle in Postgres) and per-IP rate limit
TENDER_OS_DAILY_CAP_MYR=5.00
TENDER_OS_RATE_LIMIT_RPM=60
